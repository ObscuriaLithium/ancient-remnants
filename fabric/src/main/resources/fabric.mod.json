{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${curseforge}",
    "sources": "${sources}",
    "issues": "${issues}"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "accessWidener": "${mod_id}.accesswidener",
  "entrypoints": {
    "main": [
      "dev.obscuria.remnants.fabric.FabricAncientRemnants"
    ],
    "client": [
      "dev.obscuria.remnants.fabric.client.FabricAncientRemnantsClient"
    ],
    "modmenu": [
      "dev.obscuria.remnants.fabric.integrations.ModMenuIntegration"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "java": ">=${java_version}",
    "minecraft": "~${minecraft_version}",
    "fragmentum": ">=${fragmentum_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${discord}"
      }
    }
  }
}
  